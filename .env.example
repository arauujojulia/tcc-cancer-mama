# Copie para .env (o .env não vai para o repositório)
# Banco PostgreSQL (se omitido, usa SQLite local só para desenvolvimento)
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/tcc_cancer_mama
# Chave AES-256 (base64) para dados identificados de pacientes. Gerar com:
#   python -m services.crypto
PACIENTE_ENCRYPTION_KEY=
# Origens permitidas no CORS, separadas por vírgula (padrão: *)
CORS_ORIGINS=http://localhost:5173
