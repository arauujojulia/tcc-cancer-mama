# Copie para .env (o .env não vai para o repositório)
# SQL Server Express (requer o "ODBC Driver 18 for SQL Server" e o banco tcc_cancer_mama criado)
# Autenticação do Windows:
DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/tcc_cancer_mama?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes
# Autenticação do SQL Server (alternativa):
# DATABASE_URL=mssql+pyodbc://USUARIO:SENHA@localhost\SQLEXPRESS/tcc_cancer_mama?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Chave que assina o cookie de sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria
# "true" em produção (cookie só por HTTPS)
SESSION_COOKIE_SECURE=false
# Origens permitidas no CORS, separadas por vírgula (explícitas; "*" não funciona com cookie)
CORS_ORIGINS=http://localhost:5173
