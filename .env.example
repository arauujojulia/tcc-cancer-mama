# Copie para .env (o .env não vai para o repositório) e gere as suas chaves.
# Nunca preencha chaves reais neste arquivo: ele é versionado.

# Chave que assina o cookie de sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Chave de criptografia AES-256-GCM dos dados do paciente.
# Gere com:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Sem ela, o modo identificado é recusado (erro 503).
PATIENT_DATA_KEY=

# "true" em produção (cookie só por HTTPS)
SESSION_COOKIE_SECURE=false

# Origens permitidas no CORS, separadas por vírgula (explícitas; "*" não funciona com cookie)
CORS_ORIGINS=http://localhost:5173

# URL do banco de testes (deve terminar em _test para segurança)
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tcc_cancer_mama_test
